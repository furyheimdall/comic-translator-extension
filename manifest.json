{
  "manifest_version": 3,
  "name": "만화 번역 · 내 서버",
  "version": "1.4.0",
  "description": "내 comic-translator 서버로 일본어 만화를 한국어로 번역합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "scripting", "declarativeNetRequest", "alarms", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "만화 번역"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }]
}
